# SwapWithUs Terraform Variables
# Copy this to terraform.tfvars and update with your actual values

project_id = "swapwithus-project"

# Primary region (used as default)
# europe-west4 = Netherlands (Eemshaven)
# europe-north1 = Finland (Helsinki)
region = "europe-west4"

# Uncomment and set if your resources are in different regions
# cloud_run_region = "europe-west4"
# sql_region = "europe-north1"
# storage_location = "EUROPE-WEST4"

# Uncomment and update if different from defaults
# sql_tier = "db-f1-micro"
# cloud_run_max_instances = 10
# cloud_run_memory = "512Mi"

# Cloudflare API Token (create in Cloudflare Dashboard -> My Profile -> API Tokens)
# cloudflare_api_token = "your-cloudflare-api-token-here"
# export TF_VAR_cloudflare_api_token=$(pass cloudflare/swapwith/api-token)

