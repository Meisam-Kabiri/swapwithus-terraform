rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is participant in conversation
    function isParticipant(conversationId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Helper function to validate message data structure
    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['sender_uid', 'receiver_uid', 'text',
                                  'created_at', 'is_read']) &&
             data.sender_uid is string &&
             data.receiver_uid is string &&
             data.text is string &&
             data.text.size() >= 1 &&        // Minimum 1 character
             data.text.size() <= 5000 &&     // Maximum 5000 characters
             data.is_read is bool &&
             data.sender_uid != data.receiver_uid;  // Can't send to yourself
    }

    // Conversations collection
    match /conversations/{conversationId} {

      // Allow read only if user is a participant in the conversation
      // This prevents users from seeing conversations they're not part of
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants;

      // Only the backend creates conversations (admin access bypasses these rules).
      // The status and listing fields decide who can see a home's exact address and a
      // host's full identity, so clients must never be able to write them.
      allow create: if false;

      // Allow update ONLY for specific fields by participants
      // This prevents malicious updates to participants array or other critical fields
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants &&
                       // Only allow updating these specific fields
                       // Status is not listed: only the backend's host-checked endpoint changes it
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['last_message', 'last_message_at',
                                   'unread_count_requester', 'unread_count_host']) &&
                       // Validate message size if updating last_message
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['last_message']) ||
                        request.resource.data.last_message.size() <= 5000);

      // Prevent deletion of conversations
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {

        // Allow read if user is participant in the conversation
        allow read: if isParticipant(conversationId);

        // Allow create if:
        // 1. User is authenticated
        // 2. User is the sender
        // 3. User is a participant in the conversation
        // 4. Message has valid structure
        // 5. Receiver is the other participant
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.sender_uid &&
                         isParticipant(conversationId) &&
                         isValidMessage() &&
                         request.resource.data.receiver_uid in
                           get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Allow update only for marking as read by receiver
        // Cannot modify any other fields
        allow update: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.receiver_uid &&
                         request.auth.uid == resource.data.receiver_uid &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['is_read', 'read_at']) &&
                         request.resource.data.is_read == true &&
                         resource.data.is_read == false;  // Can only mark unread as read

        // No deletes allowed - preserve message history
        allow delete: if false;
      }
    }

    // User Interests collection - pre-launch email & clicks collection
    match /userInterests/{interestId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Category Suggestions collection - user voting collection
    match /categorySuggestions/{suggestionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
